# SkillBridge — Your Network, Your Opportunity
# Environment Variables Example

# Google Gemini API Key for live AI Message Studio generation
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL & Auth Credentials
# Get your project URL and anon key from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: GitHub Personal Access Token to avoid public API rate limits (60 req/hr unauth vs 5000 req/hr auth)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
